{
  "name": "cardinal-skill",
  "version": "0.1.0",
  "private": true,
  "description": "Cardinal Skill — AI-generated skill trees from any course syllabus. Web, iOS, and Android from one codebase.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/**/*.test.ts\"",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "fn:serve": "supabase functions serve parse-syllabus --env-file .env"
  },
  "dependencies": {
    "@expo-google-fonts/dotgothic16": "^0.4.1",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-font": "~14.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
