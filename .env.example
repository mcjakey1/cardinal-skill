# Copy to .env and fill in. .env is gitignored.

# --- Client (safe to ship in the app bundle) ---
# EXPO_PUBLIC_ vars are inlined into the JS bundle. Only ever put values here
# that are safe for a student to read out of the app. The anon key is one of
# them; it grants nothing on its own because every table is behind RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# --- Server only (Supabase Edge Function secrets) ---
# Set with: supabase secrets set BAI_API_KEY=... GEMINI_API_KEY=...
# These must never appear in an EXPO_PUBLIC_ var or in client code.
# `npm run fn:serve` loads this file, so both provider keys must be here or the
# functions answer 503 "not configured yet".
#
# GEMINI_API_KEY  — parse-syllabus (the syllabus parser).
# BAI_API_KEY     — study-companion and suggest-subtree.
BAI_API_KEY=your-b-ai-key
GEMINI_API_KEY=your-gemini-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
